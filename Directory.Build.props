<Project>

  <!--
    Applies repo-wide to every .csproj under this directory, including the projects that land
    with PR #1. Kept deliberately non-breaking: analyzers run and code-style violations surface
    as build warnings, but nothing here is elevated to an error so a pre-existing intentional
    warning (e.g. the AOT-trimming IL3050 notice on YamlDotNet) doesn't fail the build.
  -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Reproducible builds: stable, path-independent PDBs when built by CI. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    SourceLink lets debuggers/crash tools resolve PDBs straight to the exact commit on GitHub. Since
    .NET 8 it ships inside the SDK and is on by default, so no PackageReference is needed. The
    explicit Microsoft.SourceLink.GitHub 8.0.0 reference was also dragging in Microsoft.Build.Tasks.Git
    8.0.0, which NU1902 flags for CVE-2026-62900 with no patched 8.0.x release.
  -->
  <PropertyGroup>
    <EnableSourceLink>true</EnableSourceLink>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
