<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the hermetic tier (docs/REQUIREMENTS.md, "Testing": ">85% line coverage").
  Source-generated JSON serializer contexts are excluded: they are compiler output, not hand-written
  code, and counting them would measure the generator rather than this project's tests.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[WgFetch.Core.Tests]*</Exclude>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
