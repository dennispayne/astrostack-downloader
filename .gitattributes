# Normalize line endings so contributors on Windows/Linux/macOS don't generate whitespace-only
# diffs, while keeping binary/vendor-installer-shaped fixtures untouched.
* text=auto eol=lf

*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.slnx text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

*.ps1 text eol=crlf

# Never let git line-ending normalization touch binary test fixtures (magic-byte sniffing,
# golden installer samples, etc.) or real binaries.
*.onnx binary
*.exe binary
*.dll binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
